# gradle-profiler IDE sync scenarios, wbs IntelliJ IDEA 2026.2.2 (build 262.10315.125), gradle/gradle.
#
#   gradle-profiler --benchmark --scenario-file wbs.scenarios --project-dir ~/workspace/gradle --gradle-user-home ~/.gradle \
#     --idea-install-dir "<the wbs app>" --idea-sandbox-dir ~/gp-sandbox-wbs --output-dir ~/gp-results-wbs [scenario...]
#
# The IDE runs with a GUI when a display is available (headless otherwise). It stays open across the iterations of one
# scenario, so later iterations are same-session re-syncs with a warm daemon; the stock sync hits the configuration
# cache then too (its action's classloader id only changes on an IDE restart). The two miss scenarios are the ones to
# compare. Use a separate sandbox directory per IDE.
# WBS: before the first run, copy the kit's plugin into the sandbox: mkdir -p ~/gp-sandbox-wbs/plugins && cp -R plugin/wbs-task-transport ~/gp-sandbox-wbs/plugins/
# The -Dwbs.* options below are the kit's wbs.vmoptions (the profiler's IDEA_VM_OPTIONS replaces the app's own file).

sync_hit {
  title = "IDE sync, configuration cache kept (wbs)"
  idea-sync { ide-jvm-args = ["-Xms256m", "-Xmx4096m", "-Dwbs.transport=tasks", "-Dwbs.transport.drop=GradleSourceSetDependencyModelProvider,GradleExternalProjectModelProvider,GradleBuildScriptClasspathModelProvider,GradleSourceSetModelProvider,GradleTaskModelProvider,AndroidAwareGradleModelProvider,ProjectModel(org.jetbrains.plugins.gradle.model.ExternalProject),ProjectModel(com.intellij.gradle.toolingExtension.impl.ideTask.payload.IdeaModulePayload),ProjectModel(org.jetbrains.plugins.gradle.model.GradleSourceSetModel),ProjectModel(org.jetbrains.plugins.gradle.model.GradleSourceSetDependencyModel),ProjectModel(org.jetbrains.kotlin.idea.gradleTooling.KotlinGradleModel),ProjectModel(com.intellij.openapi.externalSystem.model.project.dependencies.ProjectDependencies),ProjectModel(org.jetbrains.plugins.gradle.model.GradleTaskModel),ProjectModel(org.jetbrains.plugins.gradle.model.GradleExtensions),ProjectModel(org.jetbrains.plugins.gradle.model.tests.ExternalTestsModel),ProjectModel(org.jetbrains.plugins.gradle.model.IntelliJProjectSettings),ProjectModel(org.jetbrains.plugins.gradle.model.IntelliJSettings),ProjectModel(org.jetbrains.plugins.gradle.model.DependencyAccessorsModel),ProjectModel(org.jetbrains.plugins.gradle.model.VersionCatalogsModel),ProjectModel(org.jetbrains.plugins.gradle.model.AnnotationProcessingModel),ProjectModel(org.jetbrains.plugins.gradle.javaModel.JavaGradleManifestModel),ProjectModel(org.jetbrains.plugins.gradle.model.RepositoryModels),ProjectModel(com.intellij.gradle.toolingExtension.model.repositoryModel.ProjectRepositoriesModel),ProjectModel(org.jetbrains.kotlin.idea.gradleTooling.model.kapt.KaptGradleModel),ProjectModel(org.jetbrains.kotlin.idea.gradleTooling.model.allopen.AllOpenModel),ProjectModel(org.jetbrains.kotlin.idea.gradleTooling.model.noarg.NoArgModel),ProjectModel(org.jetbrains.kotlin.idea.gradleTooling.model.samWithReceiver.SamWithReceiverModel),ProjectModel(org.jetbrains.kotlin.idea.gradleTooling.model.assignment.AssignmentModel),ProjectModel(org.jetbrains.kotlin.idea.gradleTooling.model.lombok.LombokModel),ProjectModel(org.jetbrains.kotlin.idea.gradleTooling.model.parcelize.ParcelizeGradleModel),ProjectModel(org.jetbrains.kotlin.idea.gradleTooling.KotlinMPPGradleModel),ProjectModel(org.jetbrains.plugins.gradle.model.GradleBuildScriptClasspathModel),ProjectModel(com.intellij.gradle.toolingExtension.impl.ideTask.payload.KotlinDslScriptPayload),BuildModel(org.gradle.tooling.model.idea.IdeaProject),KotlinDslScriptModelProvider", "-Dwbs.transport.run=only", "-Dwbs.transport.tree=task"] }
  warm-ups = 1
  iterations = 3
}

sync_miss_settings {
  title = "IDE sync, settings script changed before every sync (wbs)"
  idea-sync { ide-jvm-args = ["-Xms256m", "-Xmx4096m", "-Dwbs.transport=tasks", "-Dwbs.transport.drop=GradleSourceSetDependencyModelProvider,GradleExternalProjectModelProvider,GradleBuildScriptClasspathModelProvider,GradleSourceSetModelProvider,GradleTaskModelProvider,AndroidAwareGradleModelProvider,ProjectModel(org.jetbrains.plugins.gradle.model.ExternalProject),ProjectModel(com.intellij.gradle.toolingExtension.impl.ideTask.payload.IdeaModulePayload),ProjectModel(org.jetbrains.plugins.gradle.model.GradleSourceSetModel),ProjectModel(org.jetbrains.plugins.gradle.model.GradleSourceSetDependencyModel),ProjectModel(org.jetbrains.kotlin.idea.gradleTooling.KotlinGradleModel),ProjectModel(com.intellij.openapi.externalSystem.model.project.dependencies.ProjectDependencies),ProjectModel(org.jetbrains.plugins.gradle.model.GradleTaskModel),ProjectModel(org.jetbrains.plugins.gradle.model.GradleExtensions),ProjectModel(org.jetbrains.plugins.gradle.model.tests.ExternalTestsModel),ProjectModel(org.jetbrains.plugins.gradle.model.IntelliJProjectSettings),ProjectModel(org.jetbrains.plugins.gradle.model.IntelliJSettings),ProjectModel(org.jetbrains.plugins.gradle.model.DependencyAccessorsModel),ProjectModel(org.jetbrains.plugins.gradle.model.VersionCatalogsModel),ProjectModel(org.jetbrains.plugins.gradle.model.AnnotationProcessingModel),ProjectModel(org.jetbrains.plugins.gradle.javaModel.JavaGradleManifestModel),ProjectModel(org.jetbrains.plugins.gradle.model.RepositoryModels),ProjectModel(com.intellij.gradle.toolingExtension.model.repositoryModel.ProjectRepositoriesModel),ProjectModel(org.jetbrains.kotlin.idea.gradleTooling.model.kapt.KaptGradleModel),ProjectModel(org.jetbrains.kotlin.idea.gradleTooling.model.allopen.AllOpenModel),ProjectModel(org.jetbrains.kotlin.idea.gradleTooling.model.noarg.NoArgModel),ProjectModel(org.jetbrains.kotlin.idea.gradleTooling.model.samWithReceiver.SamWithReceiverModel),ProjectModel(org.jetbrains.kotlin.idea.gradleTooling.model.assignment.AssignmentModel),ProjectModel(org.jetbrains.kotlin.idea.gradleTooling.model.lombok.LombokModel),ProjectModel(org.jetbrains.kotlin.idea.gradleTooling.model.parcelize.ParcelizeGradleModel),ProjectModel(org.jetbrains.kotlin.idea.gradleTooling.KotlinMPPGradleModel),ProjectModel(org.jetbrains.plugins.gradle.model.GradleBuildScriptClasspathModel),ProjectModel(com.intellij.gradle.toolingExtension.impl.ideTask.payload.KotlinDslScriptPayload),BuildModel(org.gradle.tooling.model.idea.IdeaProject),KotlinDslScriptModelProvider", "-Dwbs.transport.run=only", "-Dwbs.transport.tree=task"] }
  apply-build-script-change-to = "settings.gradle.kts"
  warm-ups = 1
  iterations = 3
}

sync_miss_cleared {
  title = "IDE sync, configuration cache deleted before every sync (wbs)"
  idea-sync { ide-jvm-args = ["-Xms256m", "-Xmx4096m", "-Dwbs.transport=tasks", "-Dwbs.transport.drop=GradleSourceSetDependencyModelProvider,GradleExternalProjectModelProvider,GradleBuildScriptClasspathModelProvider,GradleSourceSetModelProvider,GradleTaskModelProvider,AndroidAwareGradleModelProvider,ProjectModel(org.jetbrains.plugins.gradle.model.ExternalProject),ProjectModel(com.intellij.gradle.toolingExtension.impl.ideTask.payload.IdeaModulePayload),ProjectModel(org.jetbrains.plugins.gradle.model.GradleSourceSetModel),ProjectModel(org.jetbrains.plugins.gradle.model.GradleSourceSetDependencyModel),ProjectModel(org.jetbrains.kotlin.idea.gradleTooling.KotlinGradleModel),ProjectModel(com.intellij.openapi.externalSystem.model.project.dependencies.ProjectDependencies),ProjectModel(org.jetbrains.plugins.gradle.model.GradleTaskModel),ProjectModel(org.jetbrains.plugins.gradle.model.GradleExtensions),ProjectModel(org.jetbrains.plugins.gradle.model.tests.ExternalTestsModel),ProjectModel(org.jetbrains.plugins.gradle.model.IntelliJProjectSettings),ProjectModel(org.jetbrains.plugins.gradle.model.IntelliJSettings),ProjectModel(org.jetbrains.plugins.gradle.model.DependencyAccessorsModel),ProjectModel(org.jetbrains.plugins.gradle.model.VersionCatalogsModel),ProjectModel(org.jetbrains.plugins.gradle.model.AnnotationProcessingModel),ProjectModel(org.jetbrains.plugins.gradle.javaModel.JavaGradleManifestModel),ProjectModel(org.jetbrains.plugins.gradle.model.RepositoryModels),ProjectModel(com.intellij.gradle.toolingExtension.model.repositoryModel.ProjectRepositoriesModel),ProjectModel(org.jetbrains.kotlin.idea.gradleTooling.model.kapt.KaptGradleModel),ProjectModel(org.jetbrains.kotlin.idea.gradleTooling.model.allopen.AllOpenModel),ProjectModel(org.jetbrains.kotlin.idea.gradleTooling.model.noarg.NoArgModel),ProjectModel(org.jetbrains.kotlin.idea.gradleTooling.model.samWithReceiver.SamWithReceiverModel),ProjectModel(org.jetbrains.kotlin.idea.gradleTooling.model.assignment.AssignmentModel),ProjectModel(org.jetbrains.kotlin.idea.gradleTooling.model.lombok.LombokModel),ProjectModel(org.jetbrains.kotlin.idea.gradleTooling.model.parcelize.ParcelizeGradleModel),ProjectModel(org.jetbrains.kotlin.idea.gradleTooling.KotlinMPPGradleModel),ProjectModel(org.jetbrains.plugins.gradle.model.GradleBuildScriptClasspathModel),ProjectModel(com.intellij.gradle.toolingExtension.impl.ideTask.payload.KotlinDslScriptPayload),BuildModel(org.gradle.tooling.model.idea.IdeaProject),KotlinDslScriptModelProvider", "-Dwbs.transport.run=only", "-Dwbs.transport.tree=task"] }
  clear-configuration-cache-state-before = BUILD
  warm-ups = 1
  iterations = 3
}
